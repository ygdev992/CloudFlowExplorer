<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$id$</id>
    <version>$version$</version>
    <title>$title$</title>
    <authors>$authors$</authors>
    <owners>$authors$</owners>
    <license type="expression">MIT</license>
    <!--
      NuGet.org gives precedence to an embedded <icon> over <iconUrl> and always exposes its
      own extension-less hosting URL for it (application/octet-stream, no file extension),
      which fails XrmToolBox's registration page icon URL validation. So we deliberately do
      NOT declare <icon> here; only <iconUrl>, pointing at a raw GitHub-hosted PNG that NuGet.org
      will then expose as-is (and that serves a proper image/png content type).
    -->
    <iconUrl>https://raw.githubusercontent.com/ygdev992/CloudFlowExplorer/main/Resources/icon-128.png</iconUrl>
    <readme>README.md</readme>
    <projectUrl>$projecturl$</projectUrl>
    <description>$description$</description>
    <summary>$description$</summary>
    <releaseNotes>$releasenotes$</releaseNotes>
    <copyright>$copyright$</copyright>
    <tags>$tags$</tags>
    <repository type="git" url="$repourl$" />
    <!--
      XrmToolBox Tool Library reads this dependency (package id "XrmToolBox") to detect
      compatibility with the installed host version. It is a non-resolvable marker package,
      not an actual downloadable dependency, so it is declared here manually rather than via
      a <PackageReference> (which would fail NuGet restore).
      Do NOT list XrmToolBoxPackage, the CRM SDK packages, MscrmTools.Xrm.Connection or
      Newtonsoft.Json here: they already ship inside every XrmToolBox installation, and
      declaring them as package dependencies can cause version conflicts with other tools.
    -->
    <dependencies>
      <group targetFramework="$targetframework$">
        <dependency id="XrmToolBox" version="$xtbversion$" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\$targetframework$\$assemblyname$.dll" target="Plugins\" />
    <!--
      ClosedXML (Export to Excel) and its transitive dependencies are NOT part of any
      XrmToolBox installation, unlike XrmToolBoxPackage/CRM SDK/Newtonsoft.Json above, so
      they must be bundled here or a fresh Tool Library install will crash on export.

      XrmToolBox review requirement: third-party assemblies must NOT sit alongside the
      plugin DLL directly under Plugins\, and must not be merged into a single assembly
      either. Per XrmToolBox's own guidance, they are placed in a subfolder named exactly
      like the plugin assembly (Plugins\$assemblyname$\) and resolved at runtime via the
      AssemblyResolve handler registered in CloudFlowExplorerPlugin's constructor.
    -->
    <file src="bin\$configuration$\$targetframework$\ClosedXML.dll" target="Plugins\$assemblyname$\" />
    <file src="bin\$configuration$\$targetframework$\DocumentFormat.OpenXml.dll" target="Plugins\$assemblyname$\" />
    <file src="bin\$configuration$\$targetframework$\ExcelNumberFormat.dll" target="Plugins\$assemblyname$\" />
    <file src="bin\$configuration$\$targetframework$\Irony.dll" target="Plugins\$assemblyname$\" />
    <file src="bin\$configuration$\$targetframework$\SixLabors.Fonts.dll" target="Plugins\$assemblyname$\" />
    <file src="bin\$configuration$\$targetframework$\System.IO.Packaging.dll" target="Plugins\$assemblyname$\" />
    <file src="bin\$configuration$\$targetframework$\XLParser.dll" target="Plugins\$assemblyname$\" />
    <file src="Resources\icon-128.png" target="\" />
    <file src="README.md" target="\" />
  </files>
</package>
