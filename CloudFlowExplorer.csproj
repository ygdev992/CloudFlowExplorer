<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Avoid duplicate attributes alongside Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <AssemblyName>CloudFlowExplorer</AssemblyName>
    <RootNamespace>CloudFlowExplorer</RootNamespace>
    <Title>Cloud Flow Explorer</Title>
    <Version>1.0.3.0</Version>
    <Authors>ygdev992</Authors>
    <Company>ygdev992</Company>
    <Copyright>Copyright (c) ygdev992 2026</Copyright>
    <Description>Search for a keyword across all Cloud Flow (Power Automate) definitions in a Dataverse environment, with a readable JSON viewer and highlighting.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Suppress framework folder in package -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5100/NU5128: expected for XrmToolBox plugins (DLLs go in Plugins/, not lib/) -->
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>

    <!-- NuGet Package Metadata (consumed as tokens by CloudFlowExplorer.nuspec via NuspecProperties) -->
    <PackageId>CloudFlowExplorer</PackageId>
    <PackageProjectUrl>https://github.com/ygdev992/CloudFlowExplorer</PackageProjectUrl>
    <!-- Space-separated: nuspec <tags> is space-delimited, and semicolons would break NuspecProperties parsing -->
    <PackageTags>XrmToolBox Dynamics365 Dataverse PowerPlatform PowerAutomate CloudFlow</PackageTags>
    <PackageReleaseNotes>Initial public release.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/ygdev992/CloudFlowExplorer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!--
      Use a hand-authored .nuspec so the published package declares only the "XrmToolBox"
      compatibility dependency expected by the Tool Library, instead of auto-generating one
      dependency entry per <PackageReference> (XrmToolBoxPackage, CRM SDK, MscrmTools.Xrm.Connection,
      Newtonsoft.Json). See CloudFlowExplorer.nuspec for details.
    -->
    <NuspecFile>CloudFlowExplorer.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <MinimumXrmToolBoxVersion>1.2025.7.71</MinimumXrmToolBoxVersion>
    <NuspecProperties>id=$(PackageId);version=$(Version);title=$(Title);authors=$(Authors);description=$(Description);copyright=$(Copyright);tags=$(PackageTags);projecturl=$(PackageProjectUrl);releasenotes=$(PackageReleaseNotes);repourl=$(RepositoryUrl);configuration=$(Configuration);targetframework=$(TargetFramework);assemblyname=$(AssemblyName);xtbversion=$(MinimumXrmToolBoxVersion)</NuspecProperties>
  </PropertyGroup>

  <ItemGroup>
    <!-- XrmToolBox plugin infrastructure -->
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71" />

    <!-- Connection lib (includes WinForms login control) -->
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.7.63" />

    <!-- Dynamics 365 / Dataverse SDK -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
    <PackageReference Include="Microsoft.CrmSdk.XrmTooling.CoreAssembly" Version="9.1.1.65" />

    <PackageReference Include="Newtonsoft.Json" Version="13.*" />

    <!-- MIT-licensed, free for commercial use (unlike EPPlus >= 5) -->
    <PackageReference Include="ClosedXML" Version="0.102.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

</Project>
